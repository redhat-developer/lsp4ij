{
  "id": "perl-dap-installer",
  "name": "perl-dap",
  "properties": {
    "serverDist": "$USER_HOME$/.lsp4ij/dap/perl-dap"
  },
  "check": {
    "fileExists": {
      "name": "Check if Perl DAP is installed",
      "file": {
        "windows": "${serverDist}/perl-dap.exe",
        "default": "${serverDist}/perl-dap"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download perl-lsp",
      "github": {
        "owner": "EffortlessMetrics",
        "repository": "perl-lsp",
        "prerelease": false,
        "asset": {
          "windows": "perllsp-*-x86_64-pc-windows-msvc.zip",
          "unix": {
            "x86_64": "perllsp-*-x86_64-unknown-linux-gnu.tar.gz",
            "arm64": "perllsp-*-aarch64-unknown-linux-gnu.tar.gz"
          },
          "mac": {
            "x86_64": "perllsp-*-x86_64-apple-darwin.tar.gz",
            "arm64": "perllsp-*-aarch64-apple-darwin.tar.gz"
          }
        }
      },
      "url": {
        "windows": "https://github.com/EffortlessMetrics/perl-lsp/releases/download/v0.17.0/perllsp-0.17.0-x86_64-pc-windows-msvc.zip",
        "unix": {
          "x86_64": "https://github.com/EffortlessMetrics/perl-lsp/releases/download/v0.17.0/perllsp-0.17.0-x86_64-unknown-linux-gnu.tar.gz",
          "arm64": "https://github.com/EffortlessMetrics/perl-lsp/releases/download/v0.17.0/perllsp-0.17.0-aarch64-unknown-linux-gnu.tar.gz"
        },
        "mac": {
          "x86_64": "https://github.com/EffortlessMetrics/perl-lsp/releases/download/v0.17.0/perllsp-0.17.0-x86_64-apple-darwin.tar.gz",
          "arm64": "https://github.com/EffortlessMetrics/perl-lsp/releases/download/v0.17.0/perllsp-0.17.0-aarch64-apple-darwin.tar.gz"
        }
      },
      "output": {
        "dir": "${serverDist}",
        "stripRootFolder": true,
        "file": {
          "name": {
            "windows": "perl-dap.exe",
            "unix": "perl-dap",
            "mac": "perl-dap"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Perl DAP server command",
          "command": "\"${output.dir}/${output.file.name}\"",
          "update": true
        }
      }
    }
  }
}
