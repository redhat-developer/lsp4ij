{
  "id": "ruby-rdbg",
  "name": "Ruby Debug",
  "executeOnStartServer": false,
  "check": {
    "exec": {
      "name": "Check if Ruby Debug is installed",
      "command": {
        "windows": "cmd /C rdbg --version",
        "default": "rdbg --version"
      },
      "ignoreStderr": true,
      "timeout": 10000
    }
  },
  "run": {
    "exec": {
      "name": "Install Ruby Debug",
      "ignoreStderr": true,
      "command": {
        "windows": "cmd /C gem install debug",
        "default": "gem install debug"
      }
    }
  }
}
