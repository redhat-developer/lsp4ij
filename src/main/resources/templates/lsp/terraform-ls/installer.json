{
  "id": "terraform-ls",
  "name": "Terraform Language Server",
  "executeOnStartServer": false,
  "properties": {
    "serverDist": "$USER_HOME$/.lsp4ij/lsp/terraform-ls"
  },
  "check": {
    "fileExists": {
      "name": "Check if terraform-ls is installed",
      "file": {
        "windows": "${serverDist}/terraform-ls.exe",
        "default": "${serverDist}/terraform-ls"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download Terraform Language Server",
      "url": {
        "windows": {
          "386": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_windows_386.zip",
          "amd64": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_windows_amd64.zip",
          "arm64": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_windows_arm64.zip"
        },
        "unix": {
          "386": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_linux_386.zip",
          "amd64": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_linux_amd64.zip",
          "arm": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_linux_arm.zip",
          "arm64": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_linux_arm64.zip"
        },
        "mac": {
          "amd64": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_darwin_amd64.zip",
          "arm64": "https://releases.hashicorp.com/terraform-ls/0.39.1/terraform-ls_0.39.1_darwin_arm64.zip"
        }
      },
      "output": {
        "dir": "${serverDist}",
        "file": {
          "name": {
            "windows": "terraform-ls.exe",
            "default": "terraform-ls"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Terraform Language server command",
          "command": "\"${output.dir}/${output.file.name}\" serve",
          "update": true
        }
      }
    }
  }
}
