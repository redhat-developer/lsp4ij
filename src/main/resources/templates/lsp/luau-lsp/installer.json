{
  "id": "luau-lsp",
  "name": "Luau Language Server",
  "executeOnStartServer": false,
  "properties": {
    "serverDist": "$USER_HOME$/.lsp4ij/lsp/luau-lsp"
  },
  "check": {
    "fileExists": {
      "name": "Check if luau-lsp is installed",
      "file": {
        "windows": "${serverDist}/luau-lsp.exe",
        "default": "${serverDist}/luau-lsp"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download luau-lsp",
      "github": {
        "owner": "JohnnyMorganz",
        "repository": "luau-lsp",
        "prerelease": false,
        "asset": {
          "windows": "luau-lsp-win64.zip",
          "unix": {
            "amd64": "luau-lsp-linux.zip",
            "arm64": "luau-lsp-linux-arm64.zip"
          },
          "mac": "luau-lsp-macos.zip"
        }
      },
      "output": {
        "dir": "${serverDist}",
        "file": {
          "name": {
            "windows": "luau-lsp.exe",
            "unix": "luau-lsp",
            "mac": "luau-lsp"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure luau-lsp server command",
          "command": "${output.dir}/${output.file.name} lsp --definitions=path/to/your/globalTypes.d.luau --docs=path/to/your/rb-docs.json",
          "update": true
        }
      }
    }
  }
}
