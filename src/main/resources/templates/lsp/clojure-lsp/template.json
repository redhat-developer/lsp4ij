{
  "id": "clojure-lsp",
  "name": "Clojure LSP",
  "programArgs": {
    "windows": "\"$USER_HOME$/.lsp4ij/lsp/clojure-lsp/clojure-lsp.exe\"",
    "default": "\"$USER_HOME$/.lsp4ij/lsp/clojure-lsp/clojure-lsp\""
  },
  "expandConfiguration": true,
  "disablePromotionFor": ["com.github.clojure-lsp"],
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "Clojure",
        "patterns": [
          "*.clj",
          "*.cljs",
          "*.cljc",
          "*.cljd",
          "*.cljr",
          "*.cljx",
          "*.clojure",
          "*.edn",
          "*.joke",
          "*.boot",
          "*.bb",
          "*.ly",
          "*.lpy",
          "*.calva-repl",
          "*.fiddle"
        ]
      },
      "languageId": "clojure"
    }
  ]
}