{
  "id": "erlang-ls-installer",
  "name": "erlang-ls",
  "executeOnStartServer": false,
  "properties": {
    "serverDist": "$USER_HOME$/.lsp4ij/lsp/erlang-ls"
  },
  "check": {
    "exec": {
      "name": "Check erlang runtime",
      "command": {
        "windows": "where escript",
        "default": "which escript"
      },
      "onSuccess": {
        "fileExists": {
          "name": "Check if erlang-ls is installed",
          "file": "${serverDist}/erlang_ls"
        }
      }
    }
  },
  "run": {
    "download": {
      "name": "Download erlang-ls",
      "github": {
        "owner": "erlang-ls",
        "repository": "erlang_ls",
        "asset": {
          "windows": "erlang_ls-win*.tar.gz",
          "unix": "erlang_ls-linux-27.tar.gz",
          "mac": "erlang_ls-macos-27.tar.gz"
        }
      },
      "output": {
        "dir": "${serverDist}",
        "file": {
          "name": "erlang_ls",
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Erlang LS server command",
          "command": "escript \"${output.dir}/${output.file.name}\"",
          "update": true
        }
      }
    }
  }
}
