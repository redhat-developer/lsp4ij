{
  "id": "erlang-ls",
  "name": "Erlang Language Server",
  "programArgs": {
    "default": "escript \"$USER_HOME$/.lsp4ij/lsp/erlang/erlang_ls\""
  },
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "Erlang",
        "patterns": [
          "*.erl",
          "*.hrl",
          "*.src",
          "*.escript",
          "*.config"
        ]
      },
      "languageId": "erlang"
    }
  ]
}
