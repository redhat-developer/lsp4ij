{
  "id": "sdl-lsp",
  "name": "sdl-lsp",
  "executeOnStartServer": false,
  "check": {
    "exec": {
      "name": "Trying current command",
      "command": "${server.command}",
      "timeout": 2000
    }
  },
  "run": {
    "download": {
      "name": "Download sdl-lsp",
      "url": "https://github.com/smart-data-lake/sdl-lsp/releases/latest/download/sdl-lsp.jar",
      "output": {
        "dir": "$PROJECT_DIR$/.sdlb"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure sdl-lsp server command",
          "command": "java -jar ${output.dir}/${output.file.name}",
          "update": true
        }
      }
    }
  }
}
