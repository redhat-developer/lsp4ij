{
  "id": "jdt-ls",
  "name": "JDT Language Server",
  "dev": true,
  "url": null,
  "programArgs": {
    "windows": "\"${BASE_DIR}/bin/jdtls.bat\" -configuration \"$USER_HOME$/.cache/jdtls\" -data \"$PROJECT_DIR$/jdtls-data\"",
    "default": "\"${BASE_DIR}/bin/jdtls\" -configuration \"$USER_HOME$/.cache/jdtls\" -data \"$PROJECT_DIR$/jdtls-data\""
  },
  "languageMappings": [
    {
      "language": "JAVA",
      "languageId": "java"
    }
  ],
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "JAVA",
        "patterns": [
          "*.java"
        ]
      },
      "languageId": "java"
    }
  ]
}