{
  "id": "vscode-html-language-server",
  "name": "HTML Language Server",
  "dev": true,
  "url": null,
  "programArgs": {
    "windows": "node \"$USER_HOME$/AppData/Local/Programs/Microsoft VS Code/resources/app/extensions/html-language-features/server/dist/node/htmlServerMain.js\" --stdio",
    "mac": "node \"/Applications/Visual Studio Code.app/Contents/Resources/app/extensions/html-language-features/server/dist/node/htmlServerMain.js\" --stdio",
    "unix": "node \"/usr/share/code/resources/app/extensions/html-language-features/server/dist/node/htmlServerMain.js\" --stdio",
    "default": "node \"resources/app/extensions/html-language-features/server/dist/node/htmlServerMain.js\" --stdio"
  },
  "transports": [
    {
      "mode": "stdio",
      "argument": "--stdio"
    },
    {
      "mode": "startAndAccept",
      "argument": "--socket=${port}"
    }
  ],
  "languageMappings": [
    {
      "language": "HTML",
      "languageId": "html"
    }
  ]
}