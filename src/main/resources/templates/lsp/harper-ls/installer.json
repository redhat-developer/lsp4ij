{
  "id": "harper-ls-installer",
  "name": "harper-ls",
  "executeOnStartServer": false,
  "properties": {
    "serverDist": "$USER_HOME$/.lsp4ij/lsp/harper-ls"
  },
  "check": {
    "fileExists": {
      "name": "Check if harper-ls is installed",
      "file": {
        "windows": "${serverDist}/harper-ls.exe",
        "default": "${serverDist}/harper-ls"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download harper-ls",
      "github": {
        "owner": "Automattic",
        "repository": "harper",
        "prerelease": false,
        "asset": {
          "windows": "harper-ls-x86_64-pc-windows-msvc.zip",
          "unix": {
            "x86_64": "harper-ls-x86_64-unknown-linux-gnu.tar.gz",
            "arm64": "harper-ls-aarch64-unknown-linux-gnu.tar.gz"
          },
          "mac": {
            "x86_64": "harper-ls-x86_64-apple-darwin.tar.gz",
            "arm64": "harper-ls-aarch64-apple-darwin.tar.gz"
          }
        }
      },
      "output": {
        "dir": "${serverDist}",
        "file": {
          "name": {
            "windows": "harper-ls.exe",
            "unix": "harper-ls",
            "mac": "harper-ls"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Harper Language server command",
          "command": "${output.dir}/${output.file.name} --stdio",
          "update": true
        }
      }
    }
  }
}
