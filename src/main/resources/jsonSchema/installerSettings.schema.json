{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Installer Step Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          { "$ref": "#/definitions/fileExists" },
          { "$ref": "#/definitions/exec" },
          { "$ref": "#/definitions/initialize" },
          { "$ref": "#/definitions/showMessage" }
        ]
      }
    }
  },
  "definitions": {
    "fileExists": {
      "type": "object",
      "properties": {
        "fileExists": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "file": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "windows": { "type": "string" },
                    "linux": { "type": "string" },
                    "mac": { "type": "string" },
                    "default": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["file"]
        }
      }
    },
    "exec": {
      "type": "object",
      "properties": {
        "exec": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "command": {
              "type": "object",
              "properties": {
                "windows": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  ]
                },
                "default": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "onFail": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            },
            "onSuccess": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            }
          },
          "required": ["command"]
        }
      }
    },
    "initialize": {
      "type": "object",
      "properties": {
        "initialize": {
          "type": "object",
          "description": "Starts the language server or debug adapter as LSP4IJ starts it, sends it the initialize request, and succeeds only if it answers within the timeout; then ends it.",
          "properties": {
            "name": { "type": "string" },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "description": "How long to wait for the answer to initialize, from the start of the server, in milliseconds. 30000 by default."
            },
            "onFail": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            },
            "onSuccess": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            }
          }
        }
      }
    },
    "showMessage": {
      "type": "object",
      "properties": {
        "showMessage": {
          "type": "object",
          "properties": {
            "message": { "type": "string" },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "exec": { "$ref": "#/definitions/exec/properties/exec" },
                  "openUrl": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "url": { "type": "string", "format": "uri" }
                    },
                    "required": ["url"]
                  }
                },
                "required": ["label"]
              }
            }
          },
          "required": ["message", "actions"]
        }
      }
    }
  }
}
