{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Installer Step Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          { "$ref": "#/definitions/fileExists" },
          { "$ref": "#/definitions/exec" },
          { "$ref": "#/definitions/initialize" },
          { "$ref": "#/definitions/showMessage" },
          { "$ref": "#/definitions/configureServer" },
          { "$ref": "#/definitions/replaceTemplateCommand" }
        ]
      }
    }
  },
  "definitions": {
    "fileExists": {
      "type": "object",
      "properties": {
        "fileExists": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "file": {
              "description": "The file to look for, by OS. A segment can have the globs * and ?, as clangd* for a folder named after its version. The file found is ${check.file} for the tasks after it, as its onSuccess: the path as written, with the macros as $USER_HOME$ kept, and of several files that a glob matches, the last in natural order, as clangd_19.1.10 after clangd_19.1.2.",
              "anyOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "windows": { "type": "string" },
                    "linux": { "type": "string" },
                    "mac": { "type": "string" },
                    "default": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "onSuccess": {
              "anyOf": [
                { "$ref": "#/definitions/replaceTemplateCommand" },
                { "$ref": "#/definitions/configureServer" }
              ]
            }
          },
          "required": ["file"]
        }
      }
    },
    "exec": {
      "type": "object",
      "properties": {
        "exec": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "command": {
              "type": "object",
              "properties": {
                "windows": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  ]
                },
                "default": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "onFail": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            },
            "onSuccess": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            }
          },
          "required": ["command"]
        }
      }
    },
    "initialize": {
      "type": "object",
      "properties": {
        "initialize": {
          "type": "object",
          "description": "Starts the language server or debug adapter as LSP4IJ starts it, sends it the initialize request, and succeeds only if it answers within the timeout; then ends it.",
          "properties": {
            "name": { "type": "string" },
            "timeout": {
              "type": "integer",
              "minimum": 1,
              "description": "How long to wait for the answer to initialize, from the start of the server, in milliseconds. 30000 by default."
            },
            "onFail": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            },
            "onSuccess": {
              "anyOf": [
                { "$ref": "#/definitions/showMessage" },
                { "$ref": "#/definitions/exec" },
                { "$ref": "#/definitions/initialize" }
              ]
            }
          }
        }
      }
    },
    "configureServer": {
      "type": "object",
      "properties": {
        "configureServer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "command": {
              "description": "The command of the server, by OS, with the properties of the tasks before it, as ${output.dir} and ${output.file.name} of a download, or ${check.file} of a fileExists.",
              "anyOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            },
            "update": { "type": "boolean" }
          },
          "required": ["command"]
        }
      }
    },
    "replaceTemplateCommand": {
      "type": "object",
      "properties": {
        "replaceTemplateCommand": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "templateCommand": {
              "description": "The command of the template, by OS, compared as written: the task changes the command of the server only while it is this one, and otherwise leaves it and succeeds.",
              "anyOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            },
            "command": {
              "description": "The command that replaces the command of the template, by OS, as \"${check.file}\" with the file that a fileExists found.",
              "anyOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            }
          },
          "required": ["templateCommand", "command"]
        }
      }
    },
    "showMessage": {
      "type": "object",
      "properties": {
        "showMessage": {
          "type": "object",
          "properties": {
            "message": { "type": "string" },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "exec": { "$ref": "#/definitions/exec/properties/exec" },
                  "openUrl": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "url": { "type": "string", "format": "uri" }
                    },
                    "required": ["url"]
                  }
                },
                "required": ["label"]
              }
            }
          },
          "required": ["message", "actions"]
        }
      }
    }
  }
}
